<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../build/config/Driver.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>bus.xhci</AssemblyName>
    <RootNamespace>Xhci</RootNamespace>
    <NoStdLib>true</NoStdLib>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../common/MiniCoreLib/MiniCoreLib.csproj" />
    <ProjectReference Include="../../../common/Microkernel.Abstractions/Microkernel.Abstractions.csproj" />
    <ProjectReference Include="../../../runtime/Userland.Runtime.ZeroAlloc/Userland.Runtime.ZeroAlloc.csproj" />
    <ProjectReference Include="../../../compiler-plugins/Microkernel.RpcGenerator/Microkernel.RpcGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../../apps/frontier_tests/XhciTest.cs" Link="XhciTest.cs" />
  </ItemGroup>
</Project>
